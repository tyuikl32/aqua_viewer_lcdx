{
  "name": "aqua-viewer",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 443",
    "http": "http-server -p 8080 -c-1 dist/aqua-viewer",
    "build": "ng build",
    "build-prod": "ng build --configuration=production",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "deploy": "ng deploy",
    "postinstall": "ngcc",
    "commit": "npx cz",
    "supportedBrowsers": "(echo export default && browserslist-useragent-regexp --allowHigherVersions) > src/app/supportedBrowsers.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/cdk": "^16.2.0",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "@angular/service-worker": "^17.3.12",
    "@ng-bootstrap/ng-bootstrap": "15.1.1",
    "@ng-icons/bootstrap-icons": "^25.0.0",
    "@ng-icons/core": "^25.0.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@types/bootstrap": "^5.2.10",
    "aegis-web-sdk": "^1.37.1",
    "bootstrap": "^5.2.3",
    "compare-versions": "^6.1.1",
    "cropperjs": "^1.5.13",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.4.12",
    "marked": "^12.0.0",
    "ngx-indexed-db": "^16.0.0",
    "ngx-pagination": "^6.0.3",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.1",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.12",
    "@types/jasmine": "~4.3.1",
    "@types/jasminewd2": "~2.0.10",
    "@types/node": "^20.1.0",
    "@types/qrcode": "^1.5.6",
    "browserslist-useragent-regexp": "^4.1.3",
    "codelyzer": "^6.0.2",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "http-server": "^14.1.1",
    "jasmine-core": "~4.6.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "protractor": "~7.0.0",
    "ts-node": "~10.9.1",
    "tslint": "~6.1.0",
    "typescript": "5.4.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}