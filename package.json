    "@angular/compiler-cli": "^21.2.18",
    "@types/jasmine": "~4.3.1",
    "@types/jasminewd2": "~2.0.10",
    "@types/node": "^20.1.0",
    "@types/qrcode": "^1.5.6",
    "browserslist-useragent-regexp": "^4.1.3",
