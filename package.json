    "@angular/localize": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/platform-browser-dynamic": "^21.2.16",
    "@angular/router": "^21.2.18",
    "@angular/service-worker": "^21.2.18",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@ng-icons/bootstrap-icons": "^32.5.0",
    "@ng-icons/core": "^32.5.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@types/bootstrap": "^5.2.10",
    "aegis-web-sdk": "^1.37.1",
